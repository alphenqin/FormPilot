FORMPILOT_HOST=127.0.0.1
FORMPILOT_PORT=4318
# 服务端专用；不要用 VITE_ 前缀，不要把密钥填进扩展。
FORMPILOT_MODEL_PROVIDER=deepseek
FORMPILOT_MODEL_BASE_URL=https://api.deepseek.com
FORMPILOT_MODEL_NAME=deepseek-flash
FORMPILOT_MODEL_API_KEY=
FORMPILOT_MODEL_DATA_POLICY_URL=https://cdn.deepseek.com/policies/en-US/deepseek-privacy-policy.html
# 独立随机本地令牌，用于扩展建立短期 API 会话。不要复用模型密钥。
FORMPILOT_API_TOKEN=

# 服务端计划存储 AES-256 密钥：独立随机 32 字节十六进制（64 字符），保管好后不要随意更换。
FORMPILOT_DATA_KEY=
